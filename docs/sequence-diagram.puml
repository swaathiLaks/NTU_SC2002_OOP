@startuml
title Restaurant Rush - One VIP customer from arrival to payment\n(manager's Waiter choice decides how much satisfaction the VIP keeps)

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
autonumber

actor Manager
participant ":GameCLI" as CLI <<boundary>>
participant ":GameController" as GC <<control>>
participant ":ArrivalSchedule" as AS <<control>>
participant ":Waiter" as W
participant "a:StaffAction" as A
participant ":Chef" as CH
participant ":Restaurant" as R <<entity>>
participant "vip:VIPCustomer" as C <<entity>>
participant "o:Order" as O <<entity>>
participant ":Cashier" as CA
participant ":Statistics" as S <<entity>>
participant ":ResultEvaluator" as RE <<control>>

Manager -> CLI : start game
loop while !isGameOver()  [currentTurn < 18]

  == Step 1: Arrivals ==
  CLI -> GC : startTurn()
  GC -> R : startTurn(turn)
  GC -> AS : customerArrivingOn(turn)
  opt [turn is an arrival turn (1, 4, 7, 10, 13, 16)]
    create C
    AS -> C : <<create>> VIPCustomer(id)
    AS --> GC : Optional<Customer>
    GC -> R : addToQueue(vip)
  end
  GC --> CLI : events
  CLI -> GC : snapshot()
  GC --> CLI : GameSnapshot
  CLI -> Manager : show turn, revenue, queue, tables, satisfaction

  == Steps 2-3: Waiter acts first ==
  loop until result.ok
    CLI -> GC : waiterOptions()
    GC -> W : availableActions(restaurant)
    W --> GC : List<StaffAction>
    GC --> CLI : options
    CLI -> Manager : list numbered tasks
    Manager -> CLI : choice
    CLI -> GC : applyWaiterAction(a)
    GC -> A : execute(restaurant)
    alt a is SeatAction  [vip WAITING and table free]
      A -> R : seatCustomer(vip, table)
      R -> C : setState(SEATED)
    else a is TakeOrderAction  [vip SEATED]
      A -> R : placeOrder(vip)
      R -> C : chooseItem(menu)
      C --> R : MenuItem
      R -> C : priceFor(baseCents)
      note right of C
        **Polymorphism (Stage 2):**
        VIPCustomer.priceFor() returns
        90% of the base price.
        The price is locked in the Order now.
      end note
      C --> R : priceCents
      create O
      R -> O : <<create>> Order(id, vip, item, priceCents)
      R -> C : setOrder(o), setState(ORDERED)
    else a is ServeAction  [o.status == READY]
      A -> R : serve(o)
      R -> O : markServed()
      R -> C : markServed(turn)
      R -> S : recordServed()
    else a is WaitAction
      note over A : nothing changes
    end
    A --> GC : ActionResult
    GC --> CLI : ActionResult
    opt [!result.ok]
      CLI -> Manager : explain why, ask again\n(task not used up)
    end
  end

  note over Manager, CLI
    **Manager choice that changes the outcome:**
    when the VIP's order is READY and a new customer
    is waiting, choosing ServeAction stops the VIP
    losing satisfaction this turn. Choosing SeatAction
    or Wait instead costs the VIP 5 more points.
  end note

  == Step 3: Chef acts after the Waiter ==
  CLI -> GC : chefOptions()
  GC -> CH : availableActions(restaurant)
  CH --> GC : List<StaffAction>
  CLI -> Manager : list orders in the kitchen
  Manager -> CLI : choice
  CLI -> GC : applyChefAction(a)
  GC -> A : execute(restaurant)
  opt a is PrepareAction  [o.isInKitchen()]
    A -> O : advance()
    O --> A : true if last unit done (status READY)
  end
  note right of O
    A dish that becomes READY now is
    served next turn at the earliest,
    because the Waiter has already acted.
  end note

  == Step 4: Eating and payment ==
  CLI -> GC : endTurn()
  GC -> GC : processEating()
  loop for each active customer
    opt [state == SERVED and servedTurn < turn]
      GC -> R : markReadyToPay(vip)
      R -> C : markReadyToPay(turn)
    end
  end
  GC -> GC : processPayment()
  GC -> CA : collectPayment(restaurant, turn)
  CA -> R : getReadyToPay().peekFirst()
  opt [oldest customer and readyToPayTurn < turn]
    CA -> O : markPaid()
    CA -> C : setState(PAID)
    CA -> S : recordPayment(priceCents, satisfaction)
    CA -> R : removeCustomer(vip)
    note right of R : table freed
  end
  CA --> GC : Optional<Customer>

  == Step 5: Waiting and abandonment ==
  GC -> GC : applyWaitingPenalties()
  loop for each active customer
    opt [isWaitingForService()]
      GC -> C : applyWaitingPenalty()
      C -> C : waitingLoss()
      note right of C : VIP loses 5\n(Regular 8, Critic 12)
      C --> GC : true if satisfaction == 0
      opt [satisfaction == 0]
        GC -> O : cancel()
        GC -> C : setState(LEFT)
        GC -> R : removeCustomer(c)
        GC -> S : recordDeparture()
      end
    end
  end
  GC --> CLI : events
  CLI -> Manager : end-of-turn results\n(served, departures, revenue, avg satisfaction)
end

== Step 6: Result after turn 18 ==
CLI -> GC : getResult()
GC -> RE : evaluate(stats, config)
RE -> S : getPaidCount(), getRevenueCents(), averageSatisfaction()
alt [paid >= 4 and revenue >= $45 and avg satisfaction >= 60]
  RE --> GC : VICTORY
else
  RE --> GC : DEFEAT
end
GC --> CLI : GameResult
CLI -> Manager : show VICTORY or DEFEAT
@enduml
